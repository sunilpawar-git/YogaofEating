import Foundation

enum IntentAlignmentService {
    static func alignmentHint(
        intention: String,
        mealItems: [String]
    ) -> String? {
        let intentLower = intention.lowercased()
        let mealText = mealItems.joined(separator: " ").lowercased()

        if intentLower.contains("light") || intentLower.contains("less") {
            let heavyKeywords = ["pizza", "burger", "fries", "fried", "cheese",
                                 "cake", "ice cream", "pasta", "biryani", "naan"]
            if heavyKeywords.contains(where: { mealText.contains($0) }) {
                return "This meal may not align with your intention to eat light"
            }
            return "Looks aligned with your light-eating intention"
        }

        if intentLower.contains("protein") {
            let proteinKeywords = ["chicken", "egg", "fish", "paneer", "dal",
                                   "tofu", "yogurt", "meat", "lentil", "whey"]
            if proteinKeywords.contains(where: { mealText.contains($0) }) {
                return "Good protein choice — matches your intention"
            }
        }

        if intentLower.contains("early") || intentLower.contains("before") {
            return nil // Timing-based — handled separately
        }

        return nil
    }
}
```

