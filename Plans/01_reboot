Full updated init, factory methods, merge, and Codable:

```swift
struct DailyReflection: Codable, Equatable {
    let feeling: ReflectionFeeling?
    let sleepQuality: SleepQuality?
    let note: String?
    let timestamp: Date
    let sleepLoggedAt: Date?
    let feelingLoggedAt: Date?
    let morningEnergyLevel: Int?
    let dailyIntention: String?

    init(
        feeling: ReflectionFeeling? = nil,
        sleepQuality: SleepQuality? = nil,
        sleepLoggedAt: Date? = nil,
        feelingLoggedAt: Date? = nil,
        note: String? = nil,
        timestamp: Date = Date(),
        morningEnergyLevel: Int? = nil,
        dailyIntention: String? = nil
    ) {
        self.feeling = feeling
        self.sleepQuality = sleepQuality
        self.sleepLoggedAt = sleepLoggedAt
        self.feelingLoggedAt = feelingLoggedAt
        self.note = note
        self.timestamp = timestamp
        self.morningEnergyLevel = morningEnergyLevel
        self.dailyIntention = dailyIntention
    }

    // Factory: existing withSleepQuality / withFeeling stay identical

    static func withReflect(
        energy: Int,
        intention: String?,
        mergeWith existing: DailyReflection
    ) -> DailyReflection {
        DailyReflection(
            feeling: existing.feeling,
            sleepQuality: existing.sleepQuality,
            sleepLoggedAt: existing.sleepLoggedAt,
            feelingLoggedAt: existing.feelingLoggedAt,
            note: existing.note,
            timestamp: Date(),
            morningEnergyLevel: energy,
            dailyIntention: intention
        )
    }

    func merging(with other: DailyReflection) -> DailyReflection {
        DailyReflection(
            feeling: self.feeling ?? other.feeling,
            sleepQuality: self.sleepQuality ?? other.sleepQuality,
            sleepLoggedAt: self.sleepLoggedAt ?? other.sleepLoggedAt,
            feelingLoggedAt: self.feelingLoggedAt ?? other.feelingLoggedAt,
            note: self.note ?? other.note,
            timestamp: max(self.timestamp, other.timestamp),
            morningEnergyLevel: self.morningEnergyLevel ?? other.morningEnergyLevel,
            dailyIntention: self.dailyIntention ?? other.dailyIntention
        )
    }

    // Codable
    enum CodingKeys: String, CodingKey {
        case feeling, sleepQuality, note, timestamp
        case sleepLoggedAt, feelingLoggedAt
        case morningEnergyLevel, dailyIntention
    }

    init(from decoder: Decoder) throws {
        let c = try decoder.container(keyedBy: CodingKeys.self)
        self.feeling = try c.decodeIfPresent(ReflectionFeeling.self, forKey: .feeling)
        self.sleepQuality = try c.decodeIfPresent(SleepQuality.self, forKey: .sleepQuality)
        self.note = try c.decodeIfPresent(String.self, forKey: .note)
        self.timestamp = try c.decode(Date.self, forKey: .timestamp)
        self.sleepLoggedAt = try c.decodeIfPresent(Date.self, forKey: .sleepLoggedAt)
        self.feelingLoggedAt = try c.decodeIfPresent(Date.self, forKey: .feelingLoggedAt)
        self.morningEnergyLevel = try c.decodeIfPresent(Int.self, forKey: .morningEnergyLevel)
        self.dailyIntention = try c.decodeIfPresent(String.self, forKey: .dailyIntention)
    }

    func encode(to encoder: Encoder) throws {
        var c = encoder.container(keyedBy: CodingKeys.self)
        try c.encodeIfPresent(self.feeling, forKey: .feeling)
        try c.encodeIfPresent(self.sleepQuality, forKey: .sleepQuality)
        try c.encodeIfPresent(self.note, forKey: .note)
        try c.encode(self.timestamp, forKey: .timestamp)
        try c.encodeIfPresent(self.sleepLoggedAt, forKey: .sleepLoggedAt)
        try c.encodeIfPresent(self.feelingLoggedAt, forKey: .feelingLoggedAt)
        try c.encodeIfPresent(self.morningEnergyLevel, forKey: .morningEnergyLevel)
        try c.encodeIfPresent(self.dailyIntention, forKey: .dailyIntention)
    }
}
```

